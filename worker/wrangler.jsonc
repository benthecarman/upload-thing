{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "upload-thing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAX_STORAGE_BYTES": "9663676416"
  },
  "triggers": {
    "crons": ["43 * * * *"]
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.ico"], "fallthrough": false }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "upload-thing-files" }
  ],
  "routes": [
    { "pattern": "files.benthecarman.dev", "custom_domain": true }
  ]
}
